{
  "version": 2,

  "app": {
    "configPath": ".\\config.json",
    "altConfigPathHint": "%AppData%\\MiHotKey\\config.json",

    "logBufferSize": 100,
    "foregroundTrackingEnabled": true,
    "foregroundHistorySize": 10,
    "targetSelectionMode": "ForegroundThenPrevious",
    "focusPolicy": "ActivateTargetTemporarily",

    "sendTimingMs": {
      "modDownToKeyDown": 5,
      "keyDownToKeyUp": 2,
      "keyUpToModUp": 2
    },

    "autostart": {
      "enabled": false
    }
  },

  "tray": {
    "reloadConfig": true,
    "showLog": true,
    "toggleForegroundTracking": true,
    "exit": true
  },

  "logging": {
    "level": "Information",
    "overrides": {
      "Target": "Debug",
      "Match": "Debug",
      "Send": "Debug",
      "Config": "Information"
    },
    "includeScopes": false,
    "maxMessageLength": 300,
    "showConfigPathsInLog": true
  },

  "inputs": {
    "hotkeys": [
      { "id": "mute", "keys": "Ctrl+Alt+M" }
    ],

    "wmi": [
      {
        "id": "tma",
        "namespace": "root\\wmi",
        "query": "SELECT * FROM TMA_WMIEvent",

        "where": { "InstanceName": "ACPI\\PNP0C14\\0x2_0" },

        "extract": { "prop": "EventDetail", "index": 2 },

        "map": {
          "1": "triangle.down",
          "6": "triangle.up",

          "2": "hexagon.down",
          "7": "hexagon.up",

          "3": "circle.down",
          "8": "circle.up",

          "4": "droplett.down",
          "9": "droplett.up",

          "5": "square.down",
          "10": "square.up"
        },

        "sessionPolicy": "Any",
        "sessionPolicyByEvent": {
          "triangle.down": "RequireUnlockedLocalSession",
          "hexagon.down": "RequireUnlockedLocalSession"
        },

        "repeatHandling": "firstDownOnlyUntilUp",
        "debounceMs": 40
      }
    ]
  },

  "bindings": {
    "mute": [
      "circle.down",
      "droplett.down",
      "square.down"
    ],
    "notepad": [
      "triangle.down"
    ],
    "console": [
      "hexagon.down"
    ]
  },

  "targets": {
    "rules": [
      {
        "id": "meet",
        "prio": 100,
        "proc": [ "chrome", "msedge" ],
        "titleHas": [ "Meet", "Google Meet", "meet.google.com" ]
      },
      {
        "id": "teams",
        "prio": 95,
        "proc": [ "ms-teams", "teams", "msteams" ],
        "titleHas": [ "Teams", "Microsoft Teams" ]
      },
      {
        "id": "telegram",
        "prio": 80,
        "proc": [ "telegram" ],
        "titleHas": [ "Telegram" ]
      },
      {
        "id": "viber",
        "prio": 75,
        "proc": [ "viber" ],
        "titleHas": [ "Viber" ]
      },
      {
        "id": "whatsapp",
        "prio": 70,
        "proc": [ "whatsapp" ],
        "titleHas": [ "WhatsApp" ]
      },
      {
        "id": "discord",
        "prio": 60,
        "proc": [ "chrome" ],
        "titleHas": [ "Discord" ]
      }
    ]
  },

  "shortcuts": {
    "meet.mute":     { "keys": "Ctrl+D",       "send": "messages" },
    "teams.mute":    { "keys": "Ctrl+Shift+M", "send": "messages" },
    "telegram.mute": { "keys": "Ctrl+M",       "send": "messages" },
    "viber.mute":    { "keys": "Ctrl+M",       "send": "messages" },
    "whatsapp.mute": { "keys": "Ctrl+Shift+M", "send": "messages" },
    "discord.mute":  { "keys": "Ctrl+Shift+M", "send": "messages" }
  },

  "programs": {
    "notepad": {
      "title": "Notepad",
      "file": "notepad.exe",
      "args": "",
      "workdir": "",
      "useShellExecute": true,
      "hidden": false,
      "captureOutput": false,
      "env": {}
    },
    "example.hiddenConsole": {
      "title": "Hidden console example",
      "file": "%ComSpec%",
      "args": "/c echo hello from MiHotKey && exit /b 0",
      "workdir": "",
      "useShellExecute": false,
      "hidden": true,
      "captureOutput": true,
      "env": { "MIHOTKEY_EXAMPLE": "1" }
    }
  },

  "routesByTrigger": {
    "mute": [
      { "rule": "meet",     "actionType": "Shortcut", "actionId": "meet.mute" },
      { "rule": "teams",    "actionType": "Shortcut", "actionId": "teams.mute" },
      { "rule": "telegram", "actionType": "Shortcut", "actionId": "telegram.mute" },
      { "rule": "viber",    "actionType": "Shortcut", "actionId": "viber.mute" },
      { "rule": "whatsapp", "actionType": "Shortcut", "actionId": "whatsapp.mute" },
      { "rule": "discord",  "actionType": "Shortcut", "actionId": "discord.mute" }
    ],
    "notepad": [
      { "actionType": "Program", "actionId": "notepad" }
    ],
    "console": [
      { "actionType": "Program", "actionId": "example.hiddenConsole" }
    ]
  }
}
