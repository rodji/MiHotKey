{
  "version": 2,

  "app": {
    "configPath": ".\\config.json",
    "altConfigPathHint": "%AppData%\\MiHotKey\\config.json",

    "logBufferSize": 5000,
    "foregroundTrackingEnabled": true,
    "foregroundHistorySize": 10,
    "targetSelectionMode": "ForegroundThenPrevious",
    "focusPolicy": "ActivateTargetTemporarily",

    "sendTimingMs": {
      "modDownToKeyDown": 5,
      "keyDownToKeyUp": 2,
      "keyUpToModUp": 2
    },

    "autostart": {
      "enabled": false
    },

    "diagnostics": {
      "sortByTabOrder": false
    }
  },

  "tray": {
    "reloadConfig": true,
    "showLog": true,
    "toggleForegroundTracking": true,
    "runDiagnostics": true,
    "exit": true
  },

  "logging": {
    "level": "Information",
    "overrides": {
      "Target": "Debug",
      "Match": "Debug",
      "Send": "Debug",
      "Config": "Information"
    },
    "includeScopes": false,
    "maxMessageLength": 5000,
    "showConfigPathsInLog": true
  },

  "inputs": {
    "hotkeys": [
      { "id": "mute", "keys": "Ctrl+Alt+M" }
    ],

    "wmi": [
      {
        "id": "tma",
        "namespace": "root\\wmi",
        "query": "SELECT * FROM TMA_WMIEvent",

        "where": { "InstanceName": "ACPI\\PNP0C14\\0x2_0" },

        "extract": { "prop": "EventDetail", "index": 2 },

        "map": {
          "1": "triangle.down",
          "6": "triangle.up",

          "2": "hexagon.down",
          "7": "hexagon.up",

          "3": "circle.down",
          "8": "circle.up",

          "4": "droplett.down",
          "9": "droplett.up",

          "5": "square.down",
          "10": "square.up"
        },

        "sessionPolicy": "Any",
        "sessionPolicyByEvent": {
          "triangle.down": "RequireUnlockedLocalSession",
          "hexagon.down": "RequireUnlockedLocalSession"
        },

        "repeatHandling": "firstDownOnlyUntilUp",
        "debounceMs": 40
      }
    ],

    "logi": [
      // MX Keys (B35B) "Lock" button over Logitech vendor HID channel (BT).
      // Captured reports:
      // - down: 11FF0800006F0000000000000000000000000000
      // - up:   11FF080000000000000000000000000000000000
      {
        "id": "mxkeys.b35b",
        "kind": "Hid",
        "vendorId": "046D",
        "productId": "B35B",
        "usagePage": 65347,
        "usage": 514,
        "map": {
          "hid:hex:11FF0800006F0000000000000000000000000000": "mx.lock.down",
          "hid:hex:11FF080000000000000000000000000000000000": "mx.lock.up"
        },
        "logRaw": true,
        "repeatHandling": "firstDownOnlyUntilUp",
        "debounceMs": 800
      }
    ]
  },

  "bindings": {
    "mute": [
      "circle.down",
      "square.down"
    ],
    "mic.toggle": [
      "droplett.down"
    ],
    "notepad": [
      "triangle.down",
      "mx.lock.down"
    ],
    "console": [
      "hexagon.down"
    ]
  },

  "targets": {
    "rules": [
      {
        "id": "meet",
        "prio": 100,
        "proc": [ "chrome" ],
        "title": [ "Meet – * - Google Chrome" ],
        "classIs": [ "Chrome_WidgetWin_1" ]
      },
      {
        "id": "teams",
        "prio": 95,
        "proc": [ "msedgewebview2", "ms-teams" ],
        "classIs": [ "TeamsWebView" ],
        "title": [ "* | Microsoft Teams" ]
      },
      {
        "id": "telegram",
        "prio": 80,
        "proc": [ "telegram" ],
        "title": [ "*Telegram*" ]
      },
      {
        "id": "viber",
        "prio": 75,
        "proc": [ "viber" ],
        "title": [ "*Viber*" ]
      },
      {
        "id": "whatsapp",
        "prio": 70,
        "proc": [ "whatsapp" ],
        "title": [ "*WhatsApp*" ]
      },
      {
        "id": "discord",
        "prio": 60,
        "proc": [ "chrome" ],
        "title": [ "*Discord*" ]
      }
    ]
  },

  "shortcuts": {
    "meet.mute":     { "keys": "Ctrl+D",       "send": "scan" },
    "teams.mute":    { "keys": "Win+Alt+K",    "send": "global" },
    "telegram.mute": { "keys": "Ctrl+M",       "send": "messages" },
    "viber.mute":    { "keys": "Ctrl+M",       "send": "messages" },
    "whatsapp.mute": { "keys": "Ctrl+Shift+M", "send": "messages" },
    "discord.mute":  { "keys": "Ctrl+Shift+M", "send": "scan" }
  },

  "programs": {
    "notepad": {
      "title": "Notepad",
      "file": "notepad.exe",
      "args": "",
      "workdir": "",
      "useShellExecute": true,
      "hidden": false,
      "captureOutput": false,
      "env": {}
    },
    "example.hiddenConsole": {
      "title": "Hidden console example",
      "file": "%ComSpec%",
      "args": "/c echo hello from MiHotKey && exit /b 0",
      "workdir": "",
      "useShellExecute": false,
      "hidden": true,
      "captureOutput": true,
      "env": { "MIHOTKEY_EXAMPLE": "1" }
    }
  },

  "audioDevices": {
    "mic.toggle": {
      "flow": "Capture",
      "role": "Communications",
      "scope": "AllActiveInFlow",
      "deviceIds": [],
      "action": "ToggleMute"
    }
  },

  "routesByTrigger": {
    "mute": [
      { "rule": "meet",     "actionType": "Shortcut", "actionId": "meet.mute" },
      { "rule": "teams",    "actionType": "Shortcut", "actionId": "teams.mute" },
      { "rule": "telegram", "actionType": "Shortcut", "actionId": "telegram.mute" },
      { "rule": "viber",    "actionType": "Shortcut", "actionId": "viber.mute" },
      { "rule": "whatsapp", "actionType": "Shortcut", "actionId": "whatsapp.mute" },
      { "rule": "discord",  "actionType": "Shortcut", "actionId": "discord.mute" }
    ],
    "mic.toggle": [
      { "actionType": "Audio", "actionId": "mic.toggle" }
    ],
    "notepad": [
      { "actionType": "Program", "actionId": "notepad" }
    ],
    "console": [
      { "actionType": "Program", "actionId": "example.hiddenConsole" }
    ]
  }
}
